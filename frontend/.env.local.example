# Browser base URL for same-origin Next.js API routes
NEXT_PUBLIC_API_URL=http://localhost:3000

# Legacy direct-browser backend helper URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# FastAPI URL used by Next.js route handlers.
# Use http://backend:8000 in Docker or http://localhost:8080 on the host.
BACKEND_INTERNAL_URL=http://localhost:8080

# Shared JWT secret (must match FastAPI; change in production)
JWT_SECRET=naz-order-papers-jwt-secret-change-in-production

# Retained direct PostgreSQL helper configuration
DATABASE_URL=postgresql://naz_user:naz_password@db:5432/naz_order_papers
