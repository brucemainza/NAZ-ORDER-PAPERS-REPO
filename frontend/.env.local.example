# Base URL for internal Next.js API (auth routes)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL for FastAPI backend (records, search, sessions)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# JWT secret for signing tokens (change in production)
JWT_SECRET=naz-order-papers-jwt-secret-change-in-production

# PostgreSQL connection string (uses Docker service name 'db' as host)
DATABASE_URL=postgresql://naz_user:naz_password@db:5432/naz_order_papers