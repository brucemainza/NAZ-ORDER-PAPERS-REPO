{
  "include": ["backend/app"],
  "exclude": [
    "**/__pycache__",
    "backend/.venv",
    "frontend/node_modules",
    "frontend/.next", "**/node_modules", "**/.*"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["backend"]
    }
  ],
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.11"
}