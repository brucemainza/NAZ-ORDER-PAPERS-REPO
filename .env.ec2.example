# Copy to .env.ec2 on the EC2 host and replace every placeholder.
POSTGRES_USER=naz_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=naz_order_papers
DATABASE_URL=postgresql+psycopg://naz_user:URL_ENCODED_PASSWORD@db:5432/naz_order_papers
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=https://orders.example.gov.zm
# Serving over plain http:// (e.g. http://<public-ip>)? Set FRONTEND_PUBLISH=80
# and SECURE_COOKIES=false, or logins will not stick.
FRONTEND_PUBLISH=127.0.0.1:3000
SECURE_COOKIES=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_LLM_MODEL=qwen3.5:4b
IMAGE_TAG=latest